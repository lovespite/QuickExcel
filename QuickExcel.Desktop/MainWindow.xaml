<Window x:Class="QuickExcel.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickExcel" Width="1360" Height="860" MinWidth="900" MinHeight="600"
 WindowStartupLocation="CenterScreen" Background="#F5F7F6" FontFamily="Microsoft YaHei UI, Segoe UI"
 FontSize="13" Foreground="{StaticResource Ink}" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="#16634B" Padding="14,0">
   <DockPanel>
    <Button DockPanel.Dock="Left" Content="QuickExcel" Click="Home_Click" Style="{StaticResource TitleButton}" FontWeight="SemiBold" ToolTip="开始页" AutomationProperties.Name="返回开始页"/>
    <Button DockPanel.Dock="Right" Content="设置" Click="Settings_Click" Style="{StaticResource TitleButton}"/>
    <TextBlock x:Name="FileTitle" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E1" BorderThickness="0,0,0,1" x:Name="CommandBar">
   <DockPanel x:Name="Toolbar" Margin="10,6">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="WorkbookPageButton" Content="工作表" Click="WorkbookPage_Click"/>
     <Button x:Name="ScriptPageButton" Content="脚本" Click="ScriptPage_Click"/>
    </StackPanel>
    <WrapPanel>
     <Menu Background="Transparent" VerticalAlignment="Center">
      <MenuItem Header="文件(_F)">
       <MenuItem Header="新建" InputGestureText="Ctrl+N" Click="New_Click"/>
       <MenuItem Header="打开…" InputGestureText="Ctrl+O" Click="Open_Click"/>
       <MenuItem x:Name="RecentFilesMenu" Header="最近文件" SubmenuOpened="RecentFiles_Opened"/>
       <Separator/>
       <MenuItem Header="保存" InputGestureText="Ctrl+S" Click="Save_Click"/>
       <MenuItem Header="另存为…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
       <MenuItem Header="导出…" Click="ExportOptions_Click"/>
       <MenuItem Header="兼容性报告…" Click="Compatibility_Click"/>
       <Separator/>
       <MenuItem Header="关闭工作簿" InputGestureText="Ctrl+W" Click="CloseDocument_Click"/>
      </MenuItem>
      <MenuItem Header="编辑(_E)">
       <MenuItem Header="查找与替换…" InputGestureText="Ctrl+F / Ctrl+H" Click="Find_Click"/>
       <MenuItem Header="定位单元格…" InputGestureText="Ctrl+G" Click="GoTo_Click"/>
       <MenuItem Header="显示更多行" Click="MoreRows_Click"/><MenuItem Header="显示更多列" Click="MoreColumns_Click"/>
      </MenuItem>
     <MenuItem Header="结构">
      <MenuItem Header="在选区前插入行" Tag="insertRow" Click="Structure_Click"/>
      <MenuItem Header="删除选区所在行" Tag="deleteRow" Click="Structure_Click"/>
      <MenuItem Header="移动选区所在行…" Tag="moveRow" Click="Structure_Click"/>
      <MenuItem Header="在选区前插入列" Tag="insertColumn" Click="Structure_Click"/>
      <MenuItem Header="删除选区所在列" Tag="deleteColumn" Click="Structure_Click"/>
      <MenuItem Header="移动选区所在列…" Tag="moveColumn" Click="Structure_Click"/>
      <Separator/>
      <MenuItem Header="设置行高…" Tag="sizeRow" Click="Structure_Click"/>
      <MenuItem Header="设置列宽…" Tag="sizeColumn" Click="Structure_Click"/>
      <MenuItem Header="隐藏选区所在行" Tag="hideRow" Click="Structure_Click"/>
      <MenuItem Header="显示选区所在行" Tag="showRow" Click="Structure_Click"/>
      <MenuItem Header="隐藏选区所在列" Tag="hideColumn" Click="Structure_Click"/>
      <MenuItem Header="显示选区所在列" Tag="showColumn" Click="Structure_Click"/>
      <Separator/>
      <MenuItem Header="重命名工作表…" Tag="rename" Click="Structure_Click"/>
      <MenuItem Header="删除工作表…" Tag="deleteSheet" Click="Structure_Click"/>
     </MenuItem>
     <MenuItem Header="数据与视图">
      <MenuItem Header="选区升序（不含表头）" Tag="asc" Click="Sort_Click" ToolTip="按当前列；移动公式调整相对引用，外部引用保留原地址"/>
      <MenuItem Header="选区降序（不含表头）" Tag="desc" Click="Sort_Click"/>
      <MenuItem Header="筛选选区（含表头）…" Click="Filter_Click"/>
      <MenuItem Header="清除筛选" Click="ClearFilter_Click"/>
      <Separator/>
      <MenuItem Header="冻结当前格上方行和左侧列" Click="Freeze_Click" ToolTip="上方最多 10 行；点击冻结行定位原格编辑；仅本次工作区"/>
      <MenuItem Header="取消冻结" Tag="clear" Click="Freeze_Click"/>
     </MenuItem>
     <MenuItem Header="格式">
      <MenuItem Header="合并单元格" Click="Merge_Click"/>
      <MenuItem Header="取消合并" Tag="unmerge" Click="Merge_Click"/>
      <Separator/>
      <MenuItem Header="粗体开关" Tag="bold" Click="Style_Click"/>
      <MenuItem Header="斜体开关" Tag="italic" Click="Style_Click"/>
      <MenuItem Header="浅黄填充" Tag="fill" Click="Style_Click"/>
      <MenuItem Header="深绿字体" Tag="font" Click="Style_Click"/>
      <MenuItem Header="左对齐" Tag="left" Click="Style_Click"/>
      <MenuItem Header="居中" Tag="center" Click="Style_Click"/>
      <MenuItem Header="右对齐" Tag="right" Click="Style_Click"/>
      <MenuItem Header="细边框" Tag="border" Click="Style_Click"/>
      <MenuItem Header="无边框" Tag="noBorder" Click="Style_Click"/>
      <Separator/>
      <MenuItem Header="常规" Tag="general" Click="Style_Click"/>
      <MenuItem Header="两位小数" Tag="number" Click="Style_Click"/>
      <MenuItem Header="百分比" Tag="percent" Click="Style_Click"/>
      <MenuItem Header="日期 yyyy-mm-dd" Tag="date" Click="Style_Click"/>
      <MenuItem Header="清除样式" Tag="reset" Click="Style_Click"/>
     </MenuItem>

     </Menu>
     <Border Width="1" Background="#DDE5E1" Margin="8,3"/>
     <Button Content="保存" Click="Save_Click" ToolTip="Ctrl+S"/>
     <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" ToolTip="撤销 · Ctrl+Z" AutomationProperties.Name="撤销"/>
     <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" ToolTip="重做 · Ctrl+Y" AutomationProperties.Name="重做"/>
    </WrapPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" x:Name="Workspace">
   <DockPanel x:Name="WorkbookPage" LastChildFill="True">
    <Border x:Name="SheetNavigation" DockPanel.Dock="Bottom" Background="#F0F4F2" BorderBrush="#DDE5E1" BorderThickness="0,1,0,0">
     <DockPanel LastChildFill="True">
      <Button x:Name="AddSheetButton" DockPanel.Dock="Right" Content="＋" Click="AddSheet_Click" Margin="4" Padding="12,5" ToolTip="新建工作表" AutomationProperties.Name="新建工作表"/>
      <ListBox x:Name="SheetPicker" SelectionChanged="SheetPicker_SelectionChanged" BorderThickness="0" Background="Transparent" Padding="4"
       ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
       AutomationProperties.Name="工作表标签" ItemContainerStyle="{StaticResource SheetTab}">
       <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      </ListBox>
     </DockPanel>
    </Border>
    <Grid x:Name="SheetPageContent" Background="White">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <Grid Margin="8,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button Click="GoTo_Click" Margin="0" Padding="3" ToolTip="定位 · Ctrl+G" AutomationProperties.Name="定位单元格"><TextBlock x:Name="CellAddress" Text="A1" FontFamily="Consolas"/></Button>
       <TextBlock Grid.Column="1" Text="ƒx" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#187553" FontSize="17"/>
       <TextBox Grid.Column="2" x:Name="FormulaBar" FontFamily="Consolas, Microsoft YaHei UI" KeyDown="FormulaBar_KeyDown" TextChanged="FormulaBar_TextChanged" AutomationProperties.Name="单元格内容或公式"/>
       <Button Grid.Column="3" Content="↵" Click="ApplyCell_Click" Margin="4,0,0,0" AutomationProperties.Name="应用单元格内容"/>
      </Grid>
      <TextBlock x:Name="ViewStatus" Margin="10,0,10,4" Foreground="{StaticResource Muted}" FontSize="11" Visibility="Collapsed"/>
     </StackPanel>
     <AdornerDecorator Grid.Row="1">
     <DataGrid x:Name="FrozenGrid" Visibility="Collapsed" MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False" MinColumnWidth="12" MaxColumnWidth="400"
       HeadersVisibility="Row" RowHeaderWidth="45" CanUserResizeRows="True" SelectionUnit="Cell" SelectionMode="Single" Background="#F1F5F1" BorderThickness="0,0,0,2" BorderBrush="#187553" HorizontalGridLinesBrush="#E7ECE8" VerticalGridLinesBrush="#E7ECE8"
       ScrollViewer.HorizontalScrollBarVisibility="Hidden" CurrentCellChanged="FrozenGrid_CurrentCellChanged" AutomationProperties.Name="冻结行，选择后定位编辑"/>
     </AdornerDecorator>
     <AdornerDecorator Grid.Row="2">
     <DataGrid x:Name="SheetGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="True" MinColumnWidth="12" MaxColumnWidth="400" CanUserResizeRows="True"
       SelectionUnit="Cell" SelectionMode="Extended" HeadersVisibility="All" RowHeaderWidth="45" ColumnHeaderHeight="32"
       GridLinesVisibility="All" HorizontalGridLinesBrush="#E7ECE8" VerticalGridLinesBrush="#E7ECE8" Background="White" BorderThickness="0,1,0,1" BorderBrush="#DCE5DF"
       EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
       ClipboardCopyMode="None" CurrentCellChanged="Grid_CurrentCellChanged" BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding" PreviewKeyDown="Grid_KeyDown"
       AutomationProperties.Name="工作表网格" ToolTip="单击选中，再次单击编辑；F2 编辑；Enter 向下；Tab 向右；Shift 扩展选区；Ctrl+C 复制结果；Ctrl+V 粘贴值；Ctrl+Shift+V 按输入解析公式">
      <DataGrid.Resources>
       <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F3F6F3"/><Setter Property="Foreground" Value="#75847A"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0,0,1,0"/><Setter Property="BorderBrush" Value="#DCE5DF"/><Setter Property="FontSize" Value="11"/></Style>
       <Style TargetType="DataGridRowHeader"><Setter Property="Background" Value="#F3F6F3"/><Setter Property="Foreground" Value="#75847A"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/></Style>
       <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E3F3E9"/><Setter Property="Foreground" Value="#174D36"/><Setter Property="BorderBrush" Value="#187553"/></Trigger></Style.Triggers>
       </Style>
      </DataGrid.Resources>
     </DataGrid>
     </AdornerDecorator>
    </Grid>
   </DockPanel>
   <Border x:Name="ScriptPanel" Background="White" Visibility="Collapsed">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#F0F4F2" BorderBrush="#DDE5E1" BorderThickness="0,0,1,0" Padding="12">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="模块" FontWeight="SemiBold" Margin="4,4,0,12"/>
        <Button Content="新建模块" Click="AddModule_Click" Margin="0,0,0,8"/>
       </StackPanel>
       <ListBox x:Name="ModulePicker" SelectionChanged="ModulePicker_SelectionChanged" Background="Transparent" BorderThickness="0" AutomationProperties.Name="脚本模块"/>
      </DockPanel>
     </Border>
     <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/></Grid.RowDefinitions>
      <DockPanel Margin="12,8">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="RunButton" Content="运行" Click="Run_Click" Style="{StaticResource Primary}" ToolTip="应用脚本并重算 · Ctrl+Enter"/>
        <Button Content="停用" Click="Disable_Click"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ModuleTitle" FontFamily="Consolas" FontWeight="SemiBold"/>
        <ComboBox x:Name="ModuleRole" Width="110" Margin="16,0,0,0" SelectionChanged="ModuleRole_SelectionChanged" AutomationProperties.Name="模块用途">
         <ComboBoxItem Content="库模块"/><ComboBoxItem Content="公式函数"/><ComboBoxItem Content="操作脚本"/><ComboBoxItem Content="公式与操作"/>
        </ComboBox>
        <TextBlock x:Name="ScriptState" Margin="20,0,0,0" Foreground="{StaticResource Muted}"/>
       </StackPanel>
      </DockPanel>
      <TextBox Grid.Row="1" x:Name="ScriptEditor" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
       FontFamily="Cascadia Code, Consolas" FontSize="14" Background="#FAFCFB" BorderThickness="0,1" Padding="20,14" TextChanged="ScriptEditor_TextChanged" SelectionChanged="ScriptEditor_SelectionChanged" SpellCheck.IsEnabled="False" AutomationProperties.Name="JavaScript 源码，Ctrl+Tab 离开编辑器"/>
      <DockPanel Grid.Row="2" Margin="12,6">
       <TextBlock x:Name="ScriptPosition" DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
       <StackPanel x:Name="ActionsPanel" Visibility="Collapsed" Orientation="Horizontal">
        <ComboBox x:Name="ActionPicker" DisplayMemberPath="Name" MinWidth="180" AutomationProperties.Name="操作脚本"/>
        <Button x:Name="RunActionButton" Content="执行动作" Click="RunAction_Click" Margin="8,0"/>
       </StackPanel>
      </DockPanel>
      <TabControl Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#DDE5E1">
       <TabItem Header="问题"><ListBox x:Name="DiagnosticsList" MouseDoubleClick="Diagnostic_Activate" KeyDown="Diagnostic_KeyDown" BorderThickness="0" AutomationProperties.Name="脚本和公式问题，Enter 定位" DisplayMemberPath="Label"/></TabItem>
       <TabItem Header="输出"><TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="运行输出"/></TabItem>
      </TabControl>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#F0F4F2" BorderBrush="#DDE5E1" BorderThickness="0,1,0,0" Padding="12,0">
   <DockPanel>
    <Button x:Name="StopCalculationButton" DockPanel.Dock="Right" Content="停止" Click="StopCalculation_Click" Visibility="Collapsed" Padding="10,1" Margin="6,2"/>
    <TextBlock x:Name="SelectionText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
  <Border x:Name="StartPage" Grid.Row="1" Grid.RowSpan="2" Background="#F5F7F6" Visibility="Collapsed">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="1000" Margin="56,40" HorizontalAlignment="Stretch">
     <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="开始" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,26"/>
      <Button Content="＋  空白工作簿" Click="New_Click" Style="{StaticResource Primary}" HorizontalContentAlignment="Left" Padding="18,18" Margin="0,0,0,12"/>
      <Button Content="打开工作簿…" Click="Open_Click" Padding="18,14" Margin="0,0,0,12"/>
      <Button x:Name="ResumeButton" Content="返回工作簿" Click="WorkbookPage_Click" Padding="18,14" Margin="0,0,0,12"/>
      <Button Content="示例工作簿" Click="Demo_Click" Padding="18,14" Margin="0,24,0,0"/>
      <Button Content="打开恢复副本…" Click="Recovery_Click" Padding="18,14" Margin="0,12,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="最近打开" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,20"/>
      <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent" MouseDoubleClick="Recent_Activate" KeyDown="Recent_KeyDown" AutomationProperties.Name="最近打开，Enter 打开">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="NoRecentText" Text="暂无最近文件" Foreground="{StaticResource Muted}" Margin="12"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Border>
 </Grid>
</Window>
