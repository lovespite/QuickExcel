<Window x:Class="QuickExcel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickExcel.Desktop"
        Title="QuickExcel"
        Width="1360"
        Height="860"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F6"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="{StaticResource Ink}"
        PreviewKeyDown="Window_KeyDown"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Border Background="#16634B"
            Padding="14,0">
      <DockPanel>
        <Button DockPanel.Dock="Left"
                Content="QuickExcel"
                Click="Home_Click"
                Style="{StaticResource TitleButton}"
                FontWeight="SemiBold"
                ToolTip="开始页"
                AutomationProperties.Name="返回开始页"/>
        <StackPanel DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    Margin="10,0,0,0"
                    IsEnabled="{Binding IsEnabled, ElementName=Toolbar}">
          <Button local:Ribbon.Icon="Save"
                  Style="{StaticResource RibbonQuickButton}"
                  Click="Save_Click"
                  ToolTip="保存 · Ctrl+S"/>
          <Button local:Ribbon.Icon="ArrowUndo"
                  Style="{StaticResource RibbonQuickButton}"
                  Click="Undo_Click"
                  x:Name="UndoButton"
                  ToolTip="撤销 · Ctrl+Z"/>
          <Button local:Ribbon.Icon="ArrowRedo"
                  Style="{StaticResource RibbonQuickButton}"
                  Click="Redo_Click"
                  x:Name="RedoButton"
                  ToolTip="重做 · Ctrl+Y"/>
        </StackPanel>
        <Button DockPanel.Dock="Right"
                Content="设置"
                Click="Settings_Click"
                Style="{StaticResource TitleButton}"/>
        <TextBlock x:Name="FileTitle"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="1"
            Background="White"
            BorderBrush="#D2D2D2"
            BorderThickness="0,0,0,1"
            x:Name="CommandBar">
      <Grid x:Name="Toolbar">
        <TabControl x:Name="RibbonTabs"
                    Style="{StaticResource RibbonTabs}"
                    SelectionChanged="RibbonTabs_SelectionChanged"
                    AutomationProperties.Name="功能区">
          <TabItem Header="开始"
                   x:Name="HomeRibbonTab">
            <StackPanel Orientation="Horizontal"
                        x:Name="HomeRibbonContent">
              <GroupBox Header="剪贴板"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel Orientation="Horizontal">
                  <Button Content="粘贴"
                          local:Ribbon.Icon="ClipboardPaste"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="RibbonPaste_Click"
                          x:Name="RibbonPasteButton"
                          Foreground="#B17A22"
                          ToolTip="内部复制保留值、公式和格式；外部文本按值粘贴 · Ctrl+V"/>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                    <Button Content="复制"
                            local:Ribbon.Icon="Copy"
                            Style="{StaticResource RibbonButton}"
                            Click="RibbonCopy_Click"
                            ToolTip="复制值、公式和格式 · Ctrl+C"/>
                    <Button Content="剪切"
                            x:Name="RibbonCutButton"
                            local:Ribbon.Icon="ClipboardCode"
                            Style="{StaticResource RibbonButton}"
                            Click="RibbonCut_Click"
                            ToolTip="粘贴后移动，Esc 取消 · Ctrl+X"/>
                    </StackPanel>
                    <Button Content="选择性粘贴 ▾"
                            local:Ribbon.Icon="ClipboardPaste"
                            Style="{StaticResource RibbonButton}"
                            Click="RibbonMenu_Click">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="只贴值" Tag="values" Click="RibbonPaste_Click"/>
                          <MenuItem Header="粘贴公式和常量 · Ctrl+Shift+V" Tag="formulas" Click="RibbonPaste_Click"/>
                          <MenuItem Header="只贴格式" Tag="formats" Click="RibbonPaste_Click"/>
                          <MenuItem Header="转置粘贴（全部）" Tag="transpose" Click="RibbonPaste_Click"/>
                          <Separator/>
                          <MenuItem Header="清空内容 · Delete" Click="RibbonClear_Click"/>
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <Button x:Name="RibbonFormatBrush" Content="格式刷"
                            local:Ribbon.Icon="PaintBrush" Style="{StaticResource RibbonButton}"
                            Click="FormatBrush_Click" ToolTip="采样当前格格式，选择目标后再次点击应用；Esc 取消"/>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="字体"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel  VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="RibbonFontFamily"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Source"
                              Width="147"
                              Style="{StaticResource RibbonCombo}"
                              SelectionChanged="RibbonFont_SelectionChanged"
                              ToolTip="字体"
                              AutomationProperties.Name="字体"/>
                    <ComboBox x:Name="RibbonFontSize"
                              Width="60"
                              Style="{StaticResource RibbonCombo}"
                              SelectionChanged="RibbonFont_SelectionChanged"
                              ToolTip="字号"
                              AutomationProperties.Name="字号"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal"
                              Margin="0,8,0,0">
                    <ToggleButton x:Name="RibbonBold"
                                  local:Ribbon.Icon="TextBold"
                                  Style="{StaticResource RibbonToggle}"
                                  Tag="bold"
                                  Click="Style_Click"
                                  ToolTip="加粗"/>
                    <ToggleButton x:Name="RibbonItalic"
                                  local:Ribbon.Icon="TextItalic"
                                  Style="{StaticResource RibbonToggle}"
                                  Tag="italic"
                                  Click="Style_Click"
                                  ToolTip="倾斜"/>
                    <Button Content=""
                            local:Ribbon.Icon="BorderAll"
                            Style="{StaticResource RibbonButton}"
                            Click="RibbonMenu_Click"
                            ToolTip="边框">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="细边框"
                                    Click="Style_Click"
                                    Tag="border"/>
                          <MenuItem Header="无边框"
                                    Click="Style_Click"
                                    Tag="noBorder"/>
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <Button local:Ribbon.Icon="PaintBucket"
                            Style="{StaticResource RibbonButton}"
                            Click="Style_Click"
                            Tag="fill"
                            ToolTip="填充颜色：浅黄"
                            Foreground="#BA8A16"/>
                    <Button local:Ribbon.Icon="TextColor"
                            Style="{StaticResource RibbonButton}"
                            Click="Style_Click"
                            Tag="font"
                            ToolTip="字体颜色：深绿"
                            Foreground="#187553"/>
                    <Button local:Ribbon.Icon="TextClearFormatting"
                            Style="{StaticResource RibbonButton}"
                            Click="Style_Click"
                            Tag="reset"
                            ToolTip="清除样式"/>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="对齐方式"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton x:Name="RibbonAlignTop"
                                    local:Ribbon.Icon="TextBoxAlignTop"
                                    Style="{StaticResource RibbonToggle}"
                                    Tag="top"
                                    Click="Style_Click"
                                    ToolTip="顶端对齐"/>
                      <ToggleButton x:Name="RibbonAlignMiddle"
                                    local:Ribbon.Icon="TextBoxAlignMiddle"
                                    Style="{StaticResource RibbonToggle}"
                                    Tag="middle"
                                    Click="Style_Click"
                                    ToolTip="垂直居中"/>
                      <ToggleButton x:Name="RibbonAlignBottom"
                                    local:Ribbon.Icon="TextBoxAlignBottom"
                                    Style="{StaticResource RibbonToggle}"
                                    Tag="bottom"
                                    Click="Style_Click"
                                    ToolTip="底端对齐"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">
                      <ToggleButton x:Name="RibbonAlignLeft"
                                    local:Ribbon.Icon="TextAlignLeft"
                                    Style="{StaticResource RibbonToggle}"
                                    Tag="left"
                                    Click="Style_Click"
                                    ToolTip="左对齐"/>
                      <ToggleButton x:Name="RibbonAlignCenter"
                                    local:Ribbon.Icon="TextAlignCenter"
                                    Style="{StaticResource RibbonToggle}"
                                    Tag="center"
                                    Click="Style_Click"
                                    ToolTip="水平居中"/>
                      <ToggleButton x:Name="RibbonAlignRight"
                                    local:Ribbon.Icon="TextAlignRight"
                                    Style="{StaticResource RibbonToggle}"
                                    Tag="right"
                                    Click="Style_Click"
                                    ToolTip="右对齐"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel  Margin="8,0,0,0">
                    <ToggleButton x:Name="RibbonWrap"
                                  Content="自动换行"
                                  local:Ribbon.Icon="TextWrap"
                                  Style="{StaticResource RibbonToggle}"
                                  Tag="wrap"
                                  Click="Style_Click"
                                  ToolTip="自动换行（可在单元格格式中调整行高）"/>
                    <Border Margin="0,8,0,0">
                      <Button Content="合并单元格 ▾"
                              local:Ribbon.Icon="TableCellsMerge"
                              Style="{StaticResource RibbonButton}"
                              Click="RibbonMenu_Click"
                              ToolTip="合并单元格">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="合并单元格"
                                      Click="Merge_Click"/>
                            <MenuItem Header="取消合并"
                                      Click="Merge_Click"
                                      Tag="unmerge"/>
                          </ContextMenu>
                        </Button.ContextMenu>
                      </Button>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="数字"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel  VerticalAlignment="Center">
                  <ComboBox x:Name="RibbonNumberFormat"
                            Width="130"
                            Style="{StaticResource RibbonCombo}"
                            SelectionChanged="RibbonNumberFormat_SelectionChanged"
                            ToolTip="数字格式"
                            AutomationProperties.Name="数字格式">
                    <ComboBoxItem Content="常规"
                                  Tag="general"/>
                    <ComboBoxItem Content="数值 · 两位小数"
                                  Tag="number"/>
                    <ComboBoxItem Content="百分比"
                                  Tag="percent"/>
                    <ComboBoxItem Content="短日期"
                                  Tag="date"/>
                    <ComboBoxItem Content="千分位" Tag="thousands"/>
                    <ComboBoxItem Content="货币（¥）" Tag="currency"/>
                    <ComboBoxItem Content="科学计数" Tag="scientific"/>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal"
                              Margin="0,8,0,0">
                    <Button local:Ribbon.Icon="TextPercent"
                            Style="{StaticResource RibbonButton}"
                            Click="Style_Click"
                            Tag="percent"
                            ToolTip="百分比"/>
                    <Button local:Ribbon.Icon="TextNumberFormat"
                            Style="{StaticResource RibbonButton}"
                            Click="Style_Click"
                            Tag="number"
                            ToolTip="两位小数"/>
                    <Button local:Ribbon.Icon="DecimalArrowLeft" Style="{StaticResource RibbonButton}" Click="DecimalPlaces_Click" Tag="increase" ToolTip="增加小数位（只改变显示）" AutomationProperties.Name="增加小数位"/>
                    <Button local:Ribbon.Icon="DecimalArrowRight" Style="{StaticResource RibbonButton}" Click="DecimalPlaces_Click" Tag="decrease" ToolTip="减少小数位（只改变显示）" AutomationProperties.Name="减少小数位"/>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="单元格"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel>
                  <Button Content="插入 ▾"
                          local:Ribbon.Icon="TableAdd"
                          Style="{StaticResource RibbonButton}"
                          Click="RibbonMenu_Click"
                          ToolTip="插入行、列或工作表">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="在选区前插入行"
                                  Click="Structure_Click"
                                  Tag="insertRow"/>
                        <MenuItem Header="在选区前插入列"
                                  Click="Structure_Click"
                                  Tag="insertColumn"/>
                        <Separator/>
                        <MenuItem Header="新建工作表"
                                  Click="AddSheet_Click"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                  <Button Content="删除 ▾"
                          local:Ribbon.Icon="TableDismiss"
                          Style="{StaticResource RibbonButton}"
                          Click="RibbonMenu_Click"
                          ToolTip="删除行、列或工作表">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="删除选区所在行"
                                  Click="Structure_Click"
                                  Tag="deleteRow"/>
                        <MenuItem Header="删除选区所在列"
                                  Click="Structure_Click"
                                  Tag="deleteColumn"/>
                        <Separator/>
                        <MenuItem Header="删除工作表…"
                                  Click="Structure_Click"
                                  Tag="deleteSheet"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                  <Button Content="格式 ▾"
                          local:Ribbon.Icon="TableSettings"
                          Style="{StaticResource RibbonButton}"
                          Click="RibbonMenu_Click"
                          ToolTip="行高、列宽、隐藏及工作表名称">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="设置行高…"
                                  Click="Structure_Click"
                                  Tag="sizeRow"/>
                        <MenuItem Header="设置列宽…"
                                  Click="Structure_Click"
                                  Tag="sizeColumn"/>
                        <Separator/>
                        <MenuItem Header="隐藏选区所在行"
                                  Click="Structure_Click"
                                  Tag="hideRow"/>
                        <MenuItem Header="显示选区所在行"
                                  Click="Structure_Click"
                                  Tag="showRow"/>
                        <MenuItem Header="隐藏选区所在列"
                                  Click="Structure_Click"
                                  Tag="hideColumn"/>
                        <MenuItem Header="显示选区所在列"
                                  Click="Structure_Click"
                                  Tag="showColumn"/>
                        <Separator/>
                        <MenuItem Header="重命名工作表…"
                                  Click="Structure_Click"
                                  Tag="rename"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="编辑"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel>
                  <Button Content="填充 / 清除 ▾" local:Ribbon.Icon="ClipboardPaste" Style="{StaticResource RibbonButton}" Click="RibbonMenu_Click">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="向下填充 · Ctrl+D" Tag="down" Click="Fill_Click"/>
                        <MenuItem Header="向右填充 · Ctrl+R" Tag="right" Click="Fill_Click"/>
                        <MenuItem Header="数字 / 日期序列…" Tag="series" Click="Fill_Click"/>
                        <Separator/>
                        <MenuItem Header="清除内容 · Delete" Click="RibbonClear_Click"/>
                        <MenuItem Header="清除格式（保留内容）" Tag="clear-formats" Click="Fill_Click"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                  <Button Content="查找替换"
                          local:Ribbon.Icon="Search"
                          Style="{StaticResource RibbonButton}"
                          Click="Find_Click"
                          ToolTip="查找与替换 · Ctrl+F / Ctrl+H"/>
                  <Button Content="定位"
                          local:Ribbon.Icon="TableSearch"
                          Style="{StaticResource RibbonButton}"
                          Click="GoTo_Click"
                          ToolTip="定位单元格 · Ctrl+G"/>
                  <Button Content="清除筛选"
                          local:Ribbon.Icon="FilterDismiss"
                          Style="{StaticResource RibbonButton}"
                          Click="ClearFilter_Click"
                          ToolTip="清除当前工作表筛选"/>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </TabItem>
          <TabItem Header="插入">
            <StackPanel Orientation="Horizontal">
              <GroupBox Header="行与列"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel Orientation="Horizontal">
                  <Button Content="插入行"
                          local:Ribbon.Icon="TableInsertRow"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="Structure_Click"
                          Tag="insertRow"
                          ToolTip="在选区前插入行"/>
                  <Button Content="插入列"
                          local:Ribbon.Icon="TableInsertColumn"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="Structure_Click"
                          Tag="insertColumn"
                          ToolTip="在选区前插入列"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="工作表"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel>
                  <Button Content="新建工作表" local:Ribbon.Icon="TableAdd" Style="{StaticResource RibbonButton}" Click="AddSheet_Click"/>
                  <Button Content="复制工作表…" local:Ribbon.Icon="Copy" Style="{StaticResource RibbonButton}" Click="SheetManage_Click" Tag="copy"/>
                  <Button Content="名称管理…" local:Ribbon.Icon="TableSearch" Style="{StaticResource RibbonButton}" Click="NameManager_Click"/>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </TabItem>
          <TabItem Header="数据">
            <StackPanel Orientation="Horizontal">
              <GroupBox Header="分组与汇总" Style="{StaticResource RibbonGroup}">
                <StackPanel>
                  <Button Content="分组…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="GroupOutline_Click"/>
                  <Button Content="取消分组…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="UngroupOutline_Click"/>
                  <Button Content="分类汇总…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="Subtotal_Click"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="数据清洗" Style="{StaticResource RibbonGroup}">
                <StackPanel>
                  <Button Content="删除重复项…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="RemoveDuplicates_Click"/>
                  <Button Content="分列…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="SplitText_Click"/>
                  <Button Content="文本转数字…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="ConvertNumbers_Click"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="验证与格式" Style="{StaticResource RibbonGroup}">
                <StackPanel>
                  <Button Content="数据验证…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="Validation_Click" ToolTip="设置列表、数值、日期、长度或公式规则"/>
                  <Button Content="清除验证…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="RemoveValidation_Click"/>
                  <Button Content="条件格式…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="ConditionalFormatting_Click"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Excel 表" Style="{StaticResource RibbonGroup}">
                <StackPanel Orientation="Horizontal">
                <StackPanel>
                  <Button Content="创建表…" local:Ribbon.Icon="TableAdd" Style="{StaticResource RibbonButton}" Click="CreateTable_Click" ToolTip="以选区首行为表头创建 Excel Table，保存名称、样式与筛选"/>
                  <Button Content="调整表范围…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="ResizeTable_Click" ToolTip="选择表内单元格，调整数据区末行；内容保留，可撤销"/>
                  <Button Content="设置计算列…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="CalculatedTableColumn_Click" ToolTip="明确替换当前表列的数据区公式，可一次撤销"/>
                </StackPanel>
                <StackPanel>
                  <Button Content="重命名表…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="RenameTable_Click"/>
                  <Button Content="重命名列…" local:Ribbon.Icon="TableSettings" Style="{StaticResource RibbonButton}" Click="RenameTableColumn_Click"/>
                </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="排序和筛选"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel Orientation="Horizontal">
                  <StackPanel>
                    <Button Content="升序"
                            local:Ribbon.Icon="TextSortAscending"
                            Style="{StaticResource RibbonButton}"
                            Click="Sort_Click"
                            Tag="asc"
                            ToolTip="按当前列升序；选区不含表头，移动公式调整相对引用"/>
                    <Button Content="降序"
                            local:Ribbon.Icon="TextSortDescending"
                            Style="{StaticResource RibbonButton}"
                            Click="Sort_Click"
                            Tag="desc"
                            ToolTip="按当前列降序；选区不含表头"/>
                    <Button Content="清除标记" local:Ribbon.Icon="TextSortAscending" Style="{StaticResource RibbonButton}"
                            Click="ClearSortState_Click" ToolTip="清除上次排序设置和标记，保留当前记录顺序，可撤销"/>
                  </StackPanel>
                  <Button Content="多级排序"
                          local:Ribbon.Icon="TextSortAscending"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="AdvancedSort_Click"
                          ToolTip="按多个列、方向和规则排序完整记录"/>
                  <Button Content="筛选"
                          local:Ribbon.Icon="Filter"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="Filter_Click"
                          ToolTip="选中含表头的矩形建立筛选区域，再从标题单元格下拉筛选；选单格时打开当前列面板"/>
                  <Button Content="清除筛选"
                          local:Ribbon.Icon="FilterDismiss"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="ClearFilter_Click"
                          ToolTip="清除当前工作表筛选"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="调整结构"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel>
                  <Button Content="移动行…"
                          local:Ribbon.Icon="TableMoveAbove"
                          Style="{StaticResource RibbonButton}"
                          Click="Structure_Click"
                          Tag="moveRow"
                          ToolTip="移动选区所在行"/>
                  <Button Content="移动列…"
                          local:Ribbon.Icon="TableMoveLeft"
                          Style="{StaticResource RibbonButton}"
                          Click="Structure_Click"
                          Tag="moveColumn"
                          ToolTip="移动选区所在列"/>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </TabItem>
          <TabItem Header="视图">
            <StackPanel Orientation="Horizontal">
              <GroupBox Header="窗口"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel Orientation="Horizontal">
                  <Button Content="冻结窗格"
                          local:Ribbon.Icon="TableFreezeColumnAndRow"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="Freeze_Click"
                          ToolTip="冻结当前格上方行和左侧列；上方最多 10 行，随工作簿保存"/>
                  <Button Content="取消冻结"
                          local:Ribbon.Icon="TableFreezeColumnAndRowDismiss"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="Freeze_Click"
                          Tag="clear"
                          ToolTip="取消冻结"/>
                  <Button Content="隐藏工作表" local:Ribbon.Icon="EyeOff" Style="{StaticResource RibbonButton}" Click="HideSheet_Click" ToolTip="隐藏当前工作表，至少保留一张可见表"/>
                  <Button Content="取消隐藏…" local:Ribbon.Icon="Eye" Style="{StaticResource RibbonButton}" Click="UnhideSheet_Click" ToolTip="显示普通隐藏工作表；非常隐藏表不在此列表"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="显示范围"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel>
                  <Button Content="显示更多行"
                          local:Ribbon.Icon="TableInsertRow"
                          Style="{StaticResource RibbonButton}"
                          Click="MoreRows_Click"
                          ToolTip="扩展网格显示行数"/>
                  <Button Content="显示更多列"
                          local:Ribbon.Icon="TableInsertColumn"
                          Style="{StaticResource RibbonButton}"
                          Click="MoreColumns_Click"
                          ToolTip="扩展网格显示列数"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="工作区"
                        Style="{StaticResource RibbonGroup}">
                <StackPanel Orientation="Horizontal">
                  <Button Content="设置"
                          local:Ribbon.Icon="WindowSettings"
                          Style="{StaticResource RibbonLargeButton}"
                          Click="Settings_Click"
                          ToolTip="工作表标签位置和网格缩放"/>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </TabItem>
        </TabControl>
        <Menu VerticalAlignment="Top"
              HorizontalAlignment="Left"
              Height="36"
              Background="Transparent"
              FontSize="15">
          <MenuItem Header="文件(_F)"
                    Padding="10,7"
                    Height="36">
            <MenuItem Header="新建"
                      InputGestureText="Ctrl+N"
                      Click="New_Click"/>
            <MenuItem Header="打开…"
                      InputGestureText="Ctrl+O"
                      Click="Open_Click"/>
            <MenuItem x:Name="RecentFilesMenu"
                      Header="最近文件"
                      SubmenuOpened="RecentFiles_Opened"/>
            <Separator/>
            <MenuItem Header="保存"
                      InputGestureText="Ctrl+S"
                      Click="Save_Click"/>
            <MenuItem Header="另存为…"
                      InputGestureText="Ctrl+Shift+S"
                      Click="SaveAs_Click"/>
            <MenuItem Header="导出…"
                      Click="ExportOptions_Click"/>
            <MenuItem Header="兼容性报告…"
                      Click="Compatibility_Click"/>
            <Separator/>
            <MenuItem Header="关闭工作簿"
                      InputGestureText="Ctrl+W"
                      Click="CloseDocument_Click"/>
          </MenuItem>
        </Menu>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Height="36"
                    Margin="0,0,8,0">
          <Button Content="工作表"
                  local:Ribbon.Icon="Table"
                  Style="{StaticResource RibbonButton}"
                  Click="WorkbookPage_Click"
                  x:Name="WorkbookPageButton"
                  ToolTip="工作表"/>
          <Button Content="脚本"
                  local:Ribbon.Icon="Code"
                  Style="{StaticResource RibbonButton}"
                  Click="ScriptPage_Click"
                  x:Name="ScriptPageButton"
                  ToolTip="脚本编辑器"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2"
          x:Name="Workspace">
      <DockPanel x:Name="WorkbookPage"
                 LastChildFill="True">
        <Border x:Name="SheetNavigation"
                DockPanel.Dock="Bottom"
                Background="#F0F4F2"
                BorderBrush="#DDE5E1"
                BorderThickness="0,1,0,0">
          <DockPanel LastChildFill="True">
            <Button x:Name="AddSheetButton"
                    DockPanel.Dock="Right"
                    Content="＋"
                    Click="AddSheet_Click"
                    Margin="4"
                    Padding="12,5"
                    ToolTip="新建工作表"
                    AutomationProperties.Name="新建工作表"/>
            <ListBox x:Name="SheetPicker"
                     SelectionChanged="SheetPicker_SelectionChanged"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     AutomationProperties.Name="工作表标签"
                     ItemContainerStyle="{StaticResource SheetTab}">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="复制工作表…" Tag="copy" Click="SheetManage_Click"/>
                  <MenuItem Header="向前移动" Tag="left" Click="SheetManage_Click"/>
                  <MenuItem Header="向后移动" Tag="right" Click="SheetManage_Click"/>
                  <Separator/>
                  <MenuItem Header="重命名…" Tag="rename" Click="Structure_Click"/>
                  <MenuItem Header="删除工作表" Tag="deleteSheet" Click="Structure_Click"/>
                  <Separator/>
                  <MenuItem Header="名称管理…" Click="NameManager_Click"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </DockPanel>
        </Border>
        <Grid x:Name="SheetPageContent"
              Background="White">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <Grid Margin="8,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button Click="GoTo_Click"
                      Margin="0"
                      Padding="3"
                      ToolTip="定位 · Ctrl+G"
                      AutomationProperties.Name="定位单元格">
                <TextBlock x:Name="CellAddress"
                           Text="A1"
                           FontFamily="Consolas"/>
              </Button>
              <Button x:Name="AutoSumButton" Grid.Column="1" Content="Σ" Click="AutoSum_Click" Padding="2" Margin="2,0"
                      ToolTip="自动求和 · Alt+=（先预览公式，再按 Enter 提交）" AutomationProperties.Name="自动求和"/>
              <TextBox Grid.Column="2"
                       x:Name="FormulaBar"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       KeyDown="FormulaBar_KeyDown"
                       TextChanged="FormulaBar_TextChanged"
                       AutomationProperties.Name="单元格内容或公式"/>
              <Button Grid.Column="3"
                      Content="↵"
                      Click="ApplyCell_Click"
                      Margin="4,0,0,0"
                      AutomationProperties.Name="应用单元格内容"/>
            </Grid>
            <StackPanel x:Name="ValidationPanel" Orientation="Horizontal" Margin="10,0,10,4" Visibility="Collapsed">
              <ComboBox x:Name="ValidationChoices" MinWidth="140" MaxWidth="280" MaxDropDownHeight="240" IsEditable="True" IsReadOnly="True"
                        ToolTip="选择允许的列表值" AutomationProperties.Name="数据验证列表"
                        DropDownOpened="ValidationChoices_Opened" SelectionChanged="ValidationChoices_Changed"/>
              <TextBlock x:Name="ValidationHint" Margin="8,3,0,0" MaxWidth="700" TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource Muted}" AutomationProperties.Name="录入提示"/>
            </StackPanel>
            <StackPanel x:Name="OutlinePanel" Orientation="Horizontal" Margin="10,0,10,4" Visibility="Collapsed">
              <TextBlock x:Name="OutlineHint" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="OutlineGroups" Width="230" MaxDropDownHeight="260" DisplayMemberPath="Label" AutomationProperties.Name="工作表分组"/>
              <Button Content="− 折叠" Click="CollapseOutline_Click" Padding="8,2" Margin="6,0,0,0"/>
              <Button Content="+ 展开" Click="ExpandOutline_Click" Padding="8,2" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ViewStatus"
                       Margin="10,0,10,4"
                       Foreground="{StaticResource Muted}"
                       FontSize="11"
                       Visibility="Collapsed"/>
          </StackPanel>
          <Grid x:Name="SheetGrid"
                Grid.Row="2"
                ClipToBounds="True"
                AutomationProperties.Name="工作表网格"/>
        </Grid>
      </DockPanel>
      <Border x:Name="ScriptPanel"
              Background="White"
              Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Background="#F0F4F2"
                  BorderBrush="#DDE5E1"
                  BorderThickness="0,0,1,0"
                  Padding="12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="模块"
                           FontWeight="SemiBold"
                           Margin="4,4,0,12"/>
                <Button Content="新建模块"
                        Click="AddModule_Click"
                        Margin="0,0,0,8"/>
                <TextBlock Text="数字签名"
                           FontWeight="SemiBold"
                           Margin="4,12,0,8"/>
                <TextBlock x:Name="SignatureState"
                           Text="未签名"
                           TextWrapping="Wrap"
                           Margin="4,0,4,8"/>
                <Button Content="签名…"
                        Click="SignScript_Click"
                        Margin="0,0,0,6"/>
                <Button Content="签名详情…"
                        Click="SignatureDetails_Click"
                        Margin="0,0,0,6"/>
                <Button Content="受信任证书…"
                        Click="TrustedCertificates_Click"
                        Margin="0,0,0,12"/>
              </StackPanel>
              <ListBox x:Name="ModulePicker"
                       SelectionChanged="ModulePicker_SelectionChanged"
                       Background="Transparent"
                       BorderThickness="0"
                       AutomationProperties.Name="脚本模块"/>
            </DockPanel>
          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="170"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="12,8">
              <StackPanel DockPanel.Dock="Right"
                          Orientation="Horizontal">
                <Button x:Name="RunButton"
                        Content="运行"
                        Click="Run_Click"
                        Style="{StaticResource Primary}"
                        ToolTip="应用脚本并重算 · Ctrl+Enter"/>
                <Button Content="停用"
                        Click="Disable_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal"
                          VerticalAlignment="Center">
                <TextBlock x:Name="ModuleTitle"
                           FontFamily="Consolas"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="ModuleRole"
                          Width="110"
                          Margin="16,0,0,0"
                          SelectionChanged="ModuleRole_SelectionChanged"
                          AutomationProperties.Name="模块用途">
                  <ComboBoxItem Content="库模块"/>
                  <ComboBoxItem Content="公式函数"/>
                  <ComboBoxItem Content="操作脚本"/>
                  <ComboBoxItem Content="公式与操作"/>
                </ComboBox>
                <TextBlock x:Name="ScriptState"
                           Margin="20,0,0,0"
                           Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </DockPanel>
            <TextBox Grid.Row="1"
                     x:Name="ScriptEditor"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Code, Consolas"
                     FontSize="14"
                     Background="#FAFCFB"
                     BorderThickness="0,1"
                     Padding="20,14"
                     TextChanged="ScriptEditor_TextChanged"
                     SelectionChanged="ScriptEditor_SelectionChanged"
                     SpellCheck.IsEnabled="False"
                     AutomationProperties.Name="JavaScript 源码，Ctrl+Tab 离开编辑器"/>
            <DockPanel Grid.Row="2"
                       Margin="12,6">
              <TextBlock x:Name="ScriptPosition"
                         DockPanel.Dock="Right"
                         VerticalAlignment="Center"
                         FontFamily="Consolas"/>
              <StackPanel x:Name="ActionsPanel"
                          Visibility="Collapsed"
                          Orientation="Horizontal">
                <ComboBox x:Name="ActionPicker"
                          DisplayMemberPath="Name"
                          MinWidth="180"
                          AutomationProperties.Name="操作脚本"/>
                <Button x:Name="RunActionButton"
                        Content="执行动作"
                        Click="RunAction_Click"
                        Margin="8,0"/>
              </StackPanel>
            </DockPanel>
            <TabControl Grid.Row="3"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#DDE5E1">
              <TabItem Header="问题">
                <ListBox x:Name="DiagnosticsList"
                         MouseDoubleClick="Diagnostic_Activate"
                         KeyDown="Diagnostic_KeyDown"
                         BorderThickness="0"
                         AutomationProperties.Name="脚本和公式问题，Enter 定位"
                         DisplayMemberPath="Label"/>
              </TabItem>
              <TabItem Header="输出">
                <TextBox x:Name="LogText"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         FontFamily="Consolas, Microsoft YaHei UI"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="运行输出"/>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3"
            Background="#F0F4F2"
            BorderBrush="#DDE5E1"
            BorderThickness="0,1,0,0"
            Padding="12,0">
      <DockPanel>
        <Button x:Name="StopCalculationButton"
                DockPanel.Dock="Right"
                Content="停止"
                Click="StopCalculation_Click"
                Visibility="Collapsed"
                Padding="10,1"
                Margin="6,2"/>
        <TextBlock x:Name="SelectionText"
                   DockPanel.Dock="Right"
                   Foreground="{StaticResource Muted}"
                   FontSize="11"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText"
                   Text="就绪"
                   FontSize="11"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Border x:Name="StartPage"
            Grid.Row="1"
            Grid.RowSpan="2"
            Background="#F5F7F6"
            Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1000"
              Margin="56,40"
              HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="开始"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Margin="0,0,0,26"/>
            <Button Content="＋  空白工作簿"
                    Click="New_Click"
                    Style="{StaticResource Primary}"
                    HorizontalContentAlignment="Left"
                    Padding="18,18"
                    Margin="0,0,0,12"/>
            <Button Content="打开工作簿…"
                    Click="Open_Click"
                    Padding="18,14"
                    Margin="0,0,0,12"/>
            <Button x:Name="ResumeButton"
                    Content="返回工作簿"
                    Click="WorkbookPage_Click"
                    Padding="18,14"
                    Margin="0,0,0,12"/>
            <Button Content="示例工作簿"
                    Click="Demo_Click"
                    Padding="18,14"
                    Margin="0,24,0,0"/>
            <Button Content="打开恢复副本…"
                    Click="Recovery_Click"
                    Padding="18,14"
                    Margin="0,12,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="最近打开"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,10,0,20"/>
            <ListBox x:Name="RecentList"
                     BorderThickness="0"
                     Background="Transparent"
                     MouseDoubleClick="Recent_Activate"
                     KeyDown="Recent_KeyDown"
                     AutomationProperties.Name="最近打开，Enter 打开">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="10,10">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Path}"
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoRecentText"
                       Text="暂无最近文件"
                       Foreground="{StaticResource Muted}"
                       Margin="12"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
