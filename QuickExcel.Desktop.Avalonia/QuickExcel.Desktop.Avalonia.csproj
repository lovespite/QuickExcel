<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QuickExcel.Avalonia</AssemblyName>
    <Version>3.7.0</Version>
    <QuickExcelDiagnostics Condition="'$(QuickExcelDiagnostics)' == ''">true</QuickExcelDiagnostics>
    <DefineConstants Condition="'$(QuickExcelDiagnostics)' == 'true'">$(DefineConstants);QUICKEXCEL_DIAGNOSTICS</DefineConstants>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/QuickExcel.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="QuickExcel.Presentation.UiText" Alias="UiText" />
    <!-- Window and executable icons are exports of Assets/QuickExcel.svg. -->
    <AvaloniaResource Include="Assets/QuickExcel.png" />
    <None Update="Assets/QuickExcel-XLSQ.ico" CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="IfDifferent" />
    <!-- CJK PDF validation creates large short-lived font buffers. Keep the desktop
         heap conservative; shared-grid latency is measured with this setting. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <PackageReference Include="Avalonia.Desktop" Version="[12.1.4]" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.1.4]" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="[12.1.1]" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="[12.0.2]" />
    <ProjectReference Include="../QuickExcel.Grid.Avalonia/QuickExcel.Grid.Avalonia.csproj" />
    <ProjectReference Include="../QuickExcel.Infrastructure/QuickExcel.Infrastructure.csproj" />
    <None Include="Licenses/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../THIRD-PARTY-LICENSES.md" Link="Licenses/THIRD-PARTY-LICENSES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../third_party/office-scripts-docs/NOTICE.md" Link="Licenses/OFFICE-SCRIPTS-NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The manifest and assets are one verified bundle. A newer destination may
         be stale or modified; it must not win over the generated source bundle. -->
    <None Include="../artifacts/avalonia/web/**/*" Link="Web/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="IfDifferent" />
  </ItemGroup>
  <!-- macOS remains a no-script preview until its separate sandbox is qualified. -->
  <Import Project="../scripts/ScriptWorker.targets" Condition="'$(RuntimeIdentifier)' != 'osx-arm64' and '$(RuntimeIdentifier)' != 'osx-x64'" />
  <ItemGroup Condition="'$(QuickExcelDiagnostics)' != 'true'">
    <Compile Remove="Diagnostics/**/*.cs" />
  </ItemGroup>
  <!-- This application does not use the previewer. Keep design-time support out of
       the production runtime/deps manifest, not just out of the copied folder. -->
  <Target Name="ExcludeAvaloniaDesigner" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'Avalonia.DesignerSupport'" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeDotNetRuntimeNotices" AfterTargets="ComputeFilesToPublish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_DotNetRuntime Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <ResolvedFileToPublish Include="@(_DotNetRuntime->'%(PackageDirectory)/LICENSE.TXT')" RelativePath="Licenses/DOTNET-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_DotNetRuntime->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" RelativePath="Licenses/DOTNET-THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeReleaseSymbols" AfterTargets="ComputeFilesToPublish" Condition="'$(QuickExcelDiagnostics)' != 'true'">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" /></ItemGroup>
  </Target>
</Project>
