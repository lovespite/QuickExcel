{
  "lodash": {
    "named-export": "return lib.sumBy([{n:2},{n:3}], 'n');",
    "collection": "return lib.default.orderBy(lib.default.uniqBy([{id:1,n:2},{id:1,n:3},{id:2,n:1}],'id'),['n'],['asc']);",
    "chain": "return lib.default.chain([3,1,3]).uniq().sortBy().value();",
    "unicode": "return lib.default.words('你好 world 123');",
    "template": "return lib.default.template('hi <%= name %>')({name:'QX'});",
    "debounce": "lib.default.debounce(()=>1,1)(); return 'scheduled';",
    "delay": "lib.default.delay(()=>1,1);return 'scheduled';"
  },
  "decimal.js": {
    "precision": "return new lib.default('0.1').plus('0.2').toString();",
    "rounding": "return new lib.default('1.005').toFixed(2);",
    "large-number": "return new lib.default('9007199254740993').plus(1).toString();",
    "clone": "const D=lib.default.clone({precision:8});return D.div(1,3).toString();"
  },
  "dayjs": {
    "leap-year": "return lib.default('2024-02-29').add(1,'year').format('YYYY-MM-DD');",
    "invalid": "return lib.default('invalid').isValid();",
    "utc": "return lib.default.utc('2024-01-01').format();",
    "timezone": "return lib.default.tz('2024-07-01 12:00','America/New_York').utc().format();",
    "strict-parse": "return lib.default('2024-02-30','YYYY-MM-DD',true).isValid();",
    "duration": "return lib.default.duration({hours:2,minutes:30}).asMinutes();"
  },
  "papaparse": {
    "quoted-csv": "return lib.default.parse('name,n\\r\\n\"a,b\",2',{header:true,dynamicTyping:true}).data;",
    "multiline": "return lib.default.parse('\"a\\nb\",3').data;",
    "unparse": "return lib.default.unparse([{a:1,b:'x,y'}]);",
    "step": "const rows=[];lib.default.parse('a,b\\n1,2',{step:r=>rows.push(r.data)});return rows;",
    "worker": "const r=lib.default.parse('1,2',{worker:true});return r?.data;",
    "download": "lib.default.parse('https://example.invalid/data.csv',{download:true});return 'started';",
    "blob": "lib.default.parse(new Blob(['1,2']));return 'started';"
  },
  "simple-statistics": {
    "descriptive": "return [lib.mean([1,2,3]),lib.standardDeviation([2,2]),lib.quantile([1,2,3,4],0.5)];",
    "regression": "return lib.linearRegression([[0,1],[1,3],[2,5]]);",
    "correlation": "return lib.sampleCorrelation([1,2,3],[2,4,6]);",
    "clustering": "return lib.ckmeans([1,2,3,10,11,12],2);"
  },
  "zod": {
    "schema": "const s=lib.z.object({name:lib.z.string(),amount:lib.z.number().nonnegative()});return [s.parse({name:'x',amount:2}),s.safeParse({name:'x',amount:-1}).success];",
    "url": "return [lib.z.url().safeParse('https://example.com/a').success,lib.z.url().safeParse('not a url').success];",
    "coerce": "return lib.z.coerce.number().parse('42');",
    "json-schema": "return lib.z.toJSONSchema(lib.z.object({n:lib.z.number()})).properties.n.type;",
    "file": "return lib.z.file().safeParse(new File(['hi'],'a.txt',{type:'text/plain'})).success;"
  },
  "fuse.js": {
    "fuzzy": "return new lib.default([{name:'apple'},{name:'banana'}],{keys:['name']}).search('aple').map(r=>r.item.name);",
    "index": "const rows=[{name:'hello'},{name:'world'}];const index=lib.default.createIndex(['name'],rows);return new lib.default(rows,{keys:['name']},lib.default.parseIndex(index.toJSON())).search('helo')[0].item.name;",
    "extended": "return new lib.default(['apple','banana'],{useExtendedSearch:true}).search('^app').map(r=>r.item);"
  },
  "arquero": {
    "group": "return lib.from([{g:'A',n:2},{g:'B',n:4},{g:'A',n:3}]).groupby('g').rollup({total:d=>lib.op.sum(d.n)}).orderby('g').objects();",
    "join": "return lib.from([{id:1,n:2},{id:2,n:3}]).join_left(lib.from([{id:1,label:'A'}]),'id').orderby('id').objects();",
    "pivot": "return lib.from([{id:1,k:'a',v:2},{id:1,k:'b',v:3}]).groupby('id').pivot('k','v').objects();",
    "window": "return lib.from([{n:3},{n:1}]).orderby('n').derive({rank:()=>lib.op.row_number()}).objects();",
    "csv": "return lib.fromCSV('a,b\\n1,2').objects();",
    "arrow": "const t=lib.from([{name:'你好',n:1},{name:'b',n:2}]);return lib.fromArrow(t.toArrowIPC()).objects();",
    "html": "return lib.from([{a:'<hi>'}]).toHTML().includes('&lt;hi&gt;');"
  },
  "mathjs": {
    "matrix": "return lib.multiply([[1,2]],[[3],[4]]);",
    "units": "return lib.unit('2 inch').toNumber('cm');",
    "expression": "return lib.evaluate('sqrt(16)+2');",
    "symbolic": "return lib.derivative('x^2','x').toString();",
    "bignumber": "return lib.add(lib.bignumber('0.1'),lib.bignumber('0.2')).toString();",
    "complex": "return lib.multiply(lib.complex(1,2),lib.complex(1,-2)).toString();",
    "linear-system": "return lib.lusolve([[2,0],[0,4]],[4,8]);",
    "random": "return typeof lib.random();"
  }
}
