<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../QuickExcel.Presentation/QuickExcel.Presentation.csproj" />

    <None Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="WorkerFixture\**\*.cs" />
    <Compile Remove="SandboxHostFixture\**\*.cs" />
    <Compile Remove="RecoveryFixture\**\*.cs" />
    <ProjectReference Include="RecoveryFixture\RecoveryFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="WorkerFixture\WorkerFixture.csproj" ReferenceOutputAssembly="false" Condition="'$(RuntimeIdentifier)' != 'osx-arm64'" />
    <ProjectReference Include="SandboxHostFixture\SandboxHostFixture.csproj" ReferenceOutputAssembly="false" Condition="'$(RuntimeIdentifier)' != 'osx-arm64'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\QuickExcel.Core\QuickExcel.Core.csproj" />
    <ProjectReference Include="..\QuickExcel.Infrastructure\QuickExcel.Infrastructure.csproj" />
  </ItemGroup>
  <Import Project="../scripts/ScriptWorker.targets" />
  <Target Name="CopyWorkerFixture" AfterTargets="Build">
    <MSBuild Projects="RecoveryFixture\RecoveryFixture.csproj" Targets="GetFixturePayload" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="RecoveryFixturePayload" />
    </MSBuild>
    <Copy SourceFiles="@(RecoveryFixturePayload)" DestinationFolder="$(TargetDir)Fixtures/RecoveryFixture" SkipUnchangedFiles="true" />
    <MSBuild Projects="WorkerFixture\WorkerFixture.csproj" Targets="GetFixturePayload" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != 'osx-arm64'">
      <Output TaskParameter="TargetOutputs" ItemName="TestFixturePayload" />
    </MSBuild>
    <Copy SourceFiles="@(TestFixturePayload)" DestinationFolder="$(TargetDir)Fixtures/WorkerFixture" SkipUnchangedFiles="true" Condition="'$(RuntimeIdentifier)' != 'osx-arm64'" />
    <MSBuild Projects="SandboxHostFixture\SandboxHostFixture.csproj" Targets="GetFixturePayload" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != 'osx-arm64'">
      <Output TaskParameter="TargetOutputs" ItemName="SandboxHostFixturePayload" />
    </MSBuild>
    <Copy SourceFiles="@(SandboxHostFixturePayload)" DestinationFolder="$(TargetDir)Fixtures/SandboxHostFixture" SkipUnchangedFiles="true" Condition="'$(RuntimeIdentifier)' != 'osx-arm64'" />
  </Target>
</Project>
