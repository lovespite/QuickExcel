<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../QuickExcel.Desktop/Interaction/*.cs" Link="DesktopInteraction/%(Filename)%(Extension)" />
    <Compile Include="../QuickExcel.Grid.Wpf/Upstream/SeriesSizes.cs" Link="Grid/SeriesSizes.cs" />
    <Compile Include="../QuickExcel.Grid.Wpf/GridCellRange.cs" Link="Grid/GridCellRange.cs" />
    <Compile Include="../QuickExcel.Grid.Wpf/Upstream/FastGridCellAddress.cs" Link="Grid/FastGridCellAddress.cs" />
    <Compile Remove="WorkerFixture\**\*.cs" />
    <Compile Remove="SandboxHostFixture\**\*.cs" />
    <ProjectReference Include="WorkerFixture\WorkerFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="SandboxHostFixture\SandboxHostFixture.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\QuickExcel.Core\QuickExcel.Core.csproj" />
    <ProjectReference Include="..\QuickExcel.Infrastructure\QuickExcel.Infrastructure.csproj" />
  </ItemGroup>
  <Import Project="../scripts/ScriptWorker.targets" />
  <Target Name="CopyWorkerFixture" AfterTargets="Build">
    <MSBuild Projects="WorkerFixture\WorkerFixture.csproj" Targets="GetFixturePayload" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="TestFixturePayload" />
    </MSBuild>
    <Copy SourceFiles="@(TestFixturePayload)" DestinationFolder="$(TargetDir)WorkerFixture" SkipUnchangedFiles="true" />
    <MSBuild Projects="SandboxHostFixture\SandboxHostFixture.csproj" Targets="GetFixturePayload" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="SandboxHostFixturePayload" />
    </MSBuild>
    <Copy SourceFiles="@(SandboxHostFixturePayload)" DestinationFolder="$(TargetDir)SandboxHostFixture" SkipUnchangedFiles="true" />
  </Target>
</Project>
