<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../QuickExcel.ScriptContracts/QuickExcel.ScriptContracts.csproj" /></ItemGroup>
  <Target Name="GetFixturePayload" Returns="@(FixturePayload)">
    <ItemGroup><FixturePayload Include="$(TargetDir)*" Exclude="$(TargetDir)*.pdb" /></ItemGroup>
  </Target>
</Project>
