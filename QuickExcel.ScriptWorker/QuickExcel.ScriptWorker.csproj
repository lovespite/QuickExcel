<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Windows release workers are independently published native executables.
         Other platform workers retain their separately validated deployment. -->
    <PublishAot Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</PublishAot>
    <RuntimeFrameworkVersion Condition="'$(RuntimeIdentifier)' == 'win-x64'">$(QuickExcelWindowsRuntimeVersion)</RuntimeFrameworkVersion>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler">
      <ILCompilerPackVersion Condition="'%(KnownILCompilerPack.TargetFramework)' == 'net10.0'">$(QuickExcelWindowsRuntimeVersion)</ILCompilerPackVersion>
    </KnownILCompilerPack>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../QuickExcel.ScriptContracts/QuickExcel.ScriptContracts.csproj" />
    <ProjectReference Include="../QuickExcel.Scripting/QuickExcel.Scripting.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">
    <None Include="../artifacts/native/linux-x64/quickexcel-sandbox;../artifacts/native/linux-x64/libquickexcel-sandbox.so" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">
    <None Include="../artifacts/native/osx-arm64/quickexcel-sandbox;../artifacts/native/osx-arm64/libquickexcel-sandbox.dylib;../artifacts/native/osx-arm64/sandbox-build-identity.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GetWorkerPayload" Returns="@(WorkerPayload)">
    <ItemGroup><WorkerPayload Include="$(TargetDir)*" Exclude="$(TargetDir)*.pdb" /></ItemGroup>
  </Target>
</Project>
